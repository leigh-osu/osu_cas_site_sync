{#
/**
 * @file
 * Default theme implementation for the legacy site link.
 *
 * Available variables:
 * - url: The full URL to the legacy node page.
 * - nid: The node ID.
 * - link_text: The text to display for the link.
 */
#}
<div class="osu-cas-legacy-link">
  <a href="{{ url }}" target="_blank" rel="noopener noreferrer">
    {{ link_text }}
    <span class="osu-cas-legacy-link__nid">(node/{{ nid }})</span>
  </a>
</div>
