<?php

/**
 * @file
 * Hook implementations for the OSU CAS Legacy Link module.
 */

/**
 * Implements hook_theme().
 */
function osu_cas_legacy_link_theme($existing, $type, $theme, $path) {
  return [
    'osu_cas_legacy_link' => [
      'variables' => [
        'url' => NULL,
        'nid' => NULL,
        'link_text' => NULL,
      ],
      'template' => 'osu-cas-legacy-link',
    ],
  ];
}
